import "package:flutter/material.dart";
import "../data/visit_log_repository.dart";
import "../models/visit_log.dart";
import "recent_visits_screen.dart";

class QuickVisitScreen extends StatefulWidget {
  const QuickVisitScreen({super.key});

  @override
  State<QuickVisitScreen> createState() => _QuickVisitScreenState();
}

class _QuickVisitScreenState extends State<QuickVisitScreen> {
  final _nameCtl = TextEditingController();
  final _notesCtl = TextEditingController();
  int? _rating;           // 1..5
  bool? _hadFries;        // null/true/false
  String? _burgerStyle;   // optional
  DateTime _date = DateTime.now();
  bool _saving = false;

  Future<void> _save() async {
    final name = _nameCtl.text.trim();
    if (name.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text("Enter a restaurant name")),
      );
      return;
    }
    setState(() => _saving = true);
    final log = VisitLog(
      restaurantName: name,
      visitedAt: _date,
      rating: _rating,
      hadFries: _hadFries,
      burgerStyle: _burgerStyle,
      notes: _notesCtl.text.trim().isEmpty ? null : _notesCtl.text.trim(),
    );
    try {
      await VisitLogRepository().save(log);
      if (!mounted) return;
      // Jump straight to history
      Navigator.of(context).pushReplacement(
        MaterialPageRoute(builder: (_) => const RecentVisitsScreen()),
      );
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text("Could not save: $e")),
      );
    } finally {
      if (mounted) setState(() => _saving = false);
    }
  }

  @override
  void dispose() {
    _nameCtl.dispose();
    _notesCtl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final canSave = !_saving && _nameCtl.text.trim().isNotEmpty;
    return Scaffold(
      appBar: AppBar(
    title: const Text("Log a visit"),
    actions: [
      IconButton(
        icon: const Icon(Icons.history),
        tooltip: "Recent",
        onPressed: () => Navigator.of(context).push(
          MaterialPageRoute(builder: (_) => const RecentVisitsScreen()),
        ),
      ),
      TextButton(
        onPressed: _saving ? null : _save,
        child: const Text("Save"),
      ),
    ],
  ),
        actions: [
          TextButton(
            onPressed: canSave ? _save : null,
            child: const Text("Save"),
          ),
        ],
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            TextField(
              controller: _nameCtl,
              onChanged: (_) => setState((){}),
              decoration: const InputDecoration(
                labelText: "Restaurant name",
                border: OutlineInputBorder(),
              ),
            ),
            const SizedBox(height: 12),
            Text("Rating", style: theme.textTheme.titleSmall),
            const SizedBox(height: 6),
            Wrap(
              spacing: 8,
              children: List.generate(5, (i) {
                final v = i + 1;
                final sel = _rating == v;
                return ChoiceChip(
                  label: Text("$v"),
                  selected: sel,
                  onSelected: (_) => setState(() => _rating = v),
                );
              }),
            ),
            const SizedBox(height: 12),
            Text("Fries?", style: theme.textTheme.titleSmall),
            const SizedBox(height: 6),
            Wrap(
              spacing: 8,
              children: [
                ChoiceChip(
                  label: const Text("Yes"),
                  selected: _hadFries == true,
                  onSelected: (_) => setState(() => _hadFries = true),
                ),
                ChoiceChip(
                  label: const Text("No"),
                  selected: _hadFries == false,
                  onSelected: (_) => setState(() => _hadFries = false),
                ),
                ChoiceChip(
                  label: const Text("Skip"),
                  selected: _hadFries == null,
                  onSelected: (_) => setState(() => _hadFries = null),
                ),
              ],
            ),
            const SizedBox(height: 12),
            DropdownButtonFormField<String>(
              value: _burgerStyle,
              items: const [
                DropdownMenuItem(value: "smash", child: Text("Smash")),
                DropdownMenuItem(value: "pub", child: Text("Pub")),
                DropdownMenuItem(value: "thin", child: Text("Thin")),
                DropdownMenuItem(value: "thick", child: Text("Thick")),
                DropdownMenuItem(value: "other", child: Text("Other")),
              ],
              decoration: const InputDecoration(
                labelText: "Burger style (optional)",
                border: OutlineInputBorder(),
              ),
              onChanged: (v) => setState(() => _burgerStyle = v),
            ),
            const SizedBox(height: 12),
            TextField(
              controller: _notesCtl,
              maxLines: 3,
              decoration: const InputDecoration(
                labelText: "Notes (optional)",
                border: OutlineInputBorder(),
              ),
            ),
          ],
        ),
      ),
      floatingActionButton: FloatingActionButton.extended(
        onPressed: canSave ? _save : null,
        icon: const Icon(Icons.save),
        label: const Text("Save"),
      ),
    );
  }
}

