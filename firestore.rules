// Firestore security rules for Similar Eats
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read-only data
    match /restaurants/{docId} { allow read: if true; }
    match /places/{docId}      { allow read: if true; }
    match /menu_items/{docId}  { allow read: if true; }

    // Visits: require signed-in user
    match /visits/{docId} {
      allow read, write: if request.auth != null;
    }

    // Per-user taste data (owner-only)
    match /userTaste/{uid}/{sub=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Taste preferences (owner-only)
    match /taste_prefs/{uid}/{sub=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Debug sandbox (owner-only)
    match /debug/{uid}/{sub=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
