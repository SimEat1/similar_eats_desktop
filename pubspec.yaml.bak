name: similar_eats_desktop
description: Offline mock simulation of Similar Eats desktop
version: 1.0.0+1

environment:
  sdk: '>=3.2.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter
  cupertino_icons: ^1.0.6
  flutter_svg: ^2.0.10+1
  google_fonts: ^6.1.0
  collection: ^1.18.0

  # Firebase
  firebase_core: ^4.1.0
  firebase_database: ^12.0.1
  firebase_remote_config: ^6.0.1
  firebase_auth: ^6.0.2
  cloud_firestore: ^6.0.1
  firebase_storage: ^13.0.2

  # Maps / geo / utils
  flutter_map: ^8.2.1
  latlong2: ^0.9.1
  geolocator: ^14.0.2
  geocoding: ^4.0.0
  url_launcher: ^6.3.2
  qr_flutter: ^4.1.0
  shared_preferences: ^2.5.3
  provider: ^6.1.5+1

  # Files / images / parsing
  file_picker: ^10.3.3
  image: ^4.5.4
  zxing2: ^0.2.4

  # DRAG & DROP for desktop
  desktop_drop: ^0.4.4

  # OCR + image pick (used on mobile; harmless on desktop)
  image_picker: ^1.2.0
  google_mlkit_text_recognition: ^0.13.1
  google_mlkit_commons: ^0.8.1

  intl: any
  meta: any

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^6.0.0
  # Use the old test helper that provides `testing.dart` + `setupFirebaseCoreMocks()`
  firebase_core_platform_interface: ^5.1.1

dependency_overrides:
  # Force the helper version everywhere so tests can import `testing.dart`
  firebase_core_platform_interface: 5.1.1

flutter:
  uses-material-design: true
  assets:
    - assets/food1.jpg
    - assets/food2.jpg
    - assets/food3.jpg
    - assets/food4.jpg

